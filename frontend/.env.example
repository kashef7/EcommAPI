# Public client configuration (embedded into the production bundle; never put secrets here)
VITE_APP_NAME=Royal Market
VITE_API_BASE_URL=/api
VITE_REQUEST_TIMEOUT_MS=15000
VITE_LOCALE=en-US
VITE_CURRENCY_CODE=USD
VITE_PAGE_SIZE=12
VITE_LOG_LEVEL=debug
VITE_LOW_STOCK_THRESHOLD=5

# Vite dev-server proxy target (server-side only; not exposed to the browser)
API_PROXY_TARGET=http://localhost:5126
